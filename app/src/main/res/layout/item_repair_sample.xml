<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp"
    android:background="#FFFFFF"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="15dp">

    <ImageView
        android:id="@+id/imgSample"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:contentDescription="Repair sample image"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery" />

    <TextView
        android:id="@+id/txtSampleDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="iPhone 13"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSampleCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Category: Mobile Phone"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtSampleService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Service: Screen Replacement"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtSampleDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Screen replacement completed."
        android:textColor="#333333"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditSample"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Edit" />

        <Button
            android:id="@+id/btnDeleteSample"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Delete" />

    </LinearLayout>

</LinearLayout>