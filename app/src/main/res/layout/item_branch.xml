<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtBranchName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Colombo Branch"
        android:textColor="#1A1A1A"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtBranchAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Colombo, Sri Lanka"
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtBranchPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="011-2345678"
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtBranchLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="6.9271, 79.8612"
        android:textColor="#777777"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Delete" />

    </LinearLayout>

</LinearLayout>