<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        tools:context=".ActorCustomer.service.ServiceDetailsActivity">


        <!-- SERVICE IMAGE -->

        <ImageView
            android:id="@+id/ivServiceImage"
            android:layout_width="0dp"
            android:layout_height="280dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerInside"
            android:contentDescription="Service image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- SERVICE NAME -->

        <TextView
            android:id="@+id/tvServiceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Service Name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/ivServiceImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- SERVICE PRICE -->

        <TextView
            android:id="@+id/tvServicePrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="LKR 0.00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvServiceTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- DESCRIPTION TITLE -->

        <TextView
            android:id="@+id/tvServiceDescriptionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="About this service"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/tvServicePrice"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- DESCRIPTION -->

        <TextView
            android:id="@+id/tvServiceDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Service description"
            android:textSize="17sp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvServiceDescriptionLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- BOOK BUTTON -->

        <Button
            android:id="@+id/btnBookThisService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Book This Service"
            android:textSize="17sp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvServiceDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>