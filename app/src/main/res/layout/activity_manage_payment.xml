<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtPaymentFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Payment"
            android:textColor="#1A1A1A"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPaymentCustomerDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Customer: Nimal Perera"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtPaymentAppointmentDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Appointment: #1001"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Amount"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtPaymentAmount"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Payment Method"
            android:textColor="#333333"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Payment Status"
            android:textColor="#333333"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerPaymentStatus"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnUpdatePayment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="Update Payment"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>