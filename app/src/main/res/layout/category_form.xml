<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtCategoryFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Device Category"
            android:textColor="#1A1A1A"
            android:textSize="25sp"
            android:textStyle="bold" />


        <!-- CATEGORY NAME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Category Name"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCategoryName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: Mobile Phone"
            android:inputType="textCapWords"
            android:padding="12dp" />


        <!-- DESCRIPTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Description"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCategoryDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Enter category description"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp" />


        <!-- PRICE MODIFIER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Price Modifier (%)"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCategoryPriceModifier"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: 10"
            android:inputType="numberDecimal|numberSigned"
            android:padding="12dp" />


        <!-- SAVE -->

        <Button
            android:id="@+id/btnSaveCategory"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="Save Category"
            android:textSize="16sp" />


        <!-- CANCEL -->

        <Button
            android:id="@+id/btnCancelCategory"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="Cancel"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>