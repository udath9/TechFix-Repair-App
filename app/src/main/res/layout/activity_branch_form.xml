<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Branch"
            android:textColor="#1A1A1A"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Branch Name"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtBranchName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Enter branch name"
            android:inputType="textCapWords"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Address"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtBranchAddress"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Enter branch address"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Phone Number"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtBranchPhone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Enter phone number"
            android:inputType="phone"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Latitude"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtLatitude"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: 6.9271"
            android:inputType="numberDecimal|numberSigned"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Longitude"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtLongitude"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: 79.8612"
            android:inputType="numberDecimal|numberSigned"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSaveBranch"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="Save Branch"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="Cancel"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>