<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtPaymentReference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payment #P1001"
        android:textColor="#1565C0"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPaymentCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Customer: Nimal Perera"
        android:textColor="#1A1A1A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPaymentAppointment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Appointment: #1001"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtPaymentAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Amount: Rs. 35000.00"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPaymentMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Method: Card"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtPaymentDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Date: 28/08/2026"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtPaymentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Paid"
        android:textColor="#2E7D32"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnManagePayment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage" />

    </LinearLayout>

</LinearLayout>