<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:padding="20dp"

    tools:context=".ActorCustomer.customer.RepairTrackingActivity">


    <!-- ================================================= -->
    <!-- TITLE -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/tvTrackingTitle"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="Track My Repair"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- SUBTITLE -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/tvTrackingSubtitle"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="Your active repair bookings"
        android:textSize="16sp"
        android:gravity="center"

        android:layout_marginTop="8dp"

        app:layout_constraintTop_toBottomOf="@id/tvTrackingTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- NO REPAIRS MESSAGE -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/tvNoRepairs"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="You have no active repairs."
        android:textSize="18sp"
        android:gravity="center"

        android:visibility="gone"

        android:layout_marginTop="40dp"

        app:layout_constraintTop_toBottomOf="@id/tvTrackingSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- REPAIR LIST -->
    <!-- ================================================= -->

    <ScrollView

        android:id="@+id/scrollRepairs"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="20dp"

        android:fillViewport="true"

        app:layout_constraintTop_toBottomOf="@id/tvTrackingSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout

            android:id="@+id/repairsContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>