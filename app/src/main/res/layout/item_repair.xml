<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtRepairId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repair #1001"
        android:textColor="#222222"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDevice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Samsung Galaxy A54"
        android:textColor="#333333"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Screen Replacement"
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtProblem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Problem: Cracked screen"
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Status: Assigned"
        android:textColor="#333333"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtRepairDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Date: 30 Aug 2026"
        android:textColor="#777777"
        android:textSize="13sp" />

</LinearLayout>