<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:padding="16dp"

    tools:context=".ActorCustomer.payment.PaymentActivity">


    <!-- ================================================= -->
    <!-- TITLE -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/tvPaymentTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="Payment Information"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"

        android:layout_marginTop="10dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- CONTENT -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="20dp"

        android:fillViewport="true"

        app:layout_constraintTop_toBottomOf="@id/tvPaymentTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">


            <!-- ========================================= -->
            <!-- CURRENT PAYMENT -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/tvOutstandingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Current Payment"
                android:textSize="21sp"
                android:textStyle="bold"

                android:padding="12dp" />


            <LinearLayout
                android:id="@+id/currentPaymentContainer"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical" />


            <!-- ========================================= -->
            <!-- SEPARATOR -->
            <!-- ========================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp" />


            <!-- ========================================= -->
            <!-- PAYMENT HISTORY -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/tvPaymentHistoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Payment History"
                android:textSize="21sp"
                android:textStyle="bold"

                android:padding="12dp" />


            <LinearLayout
                android:id="@+id/paymentHistoryContainer"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>