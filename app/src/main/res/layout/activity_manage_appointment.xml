<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtManageAppointmentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Appointment"
            android:textColor="#1A1A1A"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtManageCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Customer: Nimal Perera"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtManageDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Device: iPhone 13"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtManageService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Service: Screen Replacement"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Branch"
            android:textColor="#333333"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerManageBranch"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Assign Technician"
            android:textColor="#333333"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerManageTechnician"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Repair Status"
            android:textColor="#333333"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerManageStatus"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Repair Price"
            android:textColor="#333333"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtManagePrice"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Enter repair price"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnUpdateAppointment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="Update Appointment"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>