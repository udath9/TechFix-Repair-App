<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTechnicianName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kasun Perera"
        android:textColor="#1A1A1A"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtTechnicianSpecialization"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Mobile Phone Repair"
        android:textColor="#1565C0"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtTechnicianBranch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Branch: Colombo"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtTechnicianPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Phone: 0771234567"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtTechnicianEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Email: technician@gmail.com"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtTechnicianAvailability"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Available"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditTechnician"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit" />

        <Button
            android:id="@+id/btnDeleteTechnician"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Delete" />

    </LinearLayout>

</LinearLayout>