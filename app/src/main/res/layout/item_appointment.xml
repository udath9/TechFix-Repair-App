<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtAppointmentId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Appointment #1001"
        android:textColor="#1565C0"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtCustomerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Customer: Nimal Perera"
        android:textColor="#1A1A1A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Device: iPhone 13"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Service: Screen Replacement"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtAppointmentDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Date: 28/08/2026"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtAppointmentTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Time: 10:30 AM"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtAppointmentBranch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Branch: Colombo"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtAppointmentTechnician"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Technician: Kasun Perera"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtAppointmentPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Estimated Price: Rs. 35000.00"
        android:textColor="#333333"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtAppointmentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Pending"
        android:textColor="#E65100"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnManageAppointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage" />

    </LinearLayout>

</LinearLayout>