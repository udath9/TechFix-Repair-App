<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtHistoryRepairId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repair #15"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHistoryDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Samsung Galaxy A54"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtHistoryService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Service: Screen Replacement"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtHistoryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Status: In Progress"
            android:textColor="#1A73E8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHistoryNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Notes: Device inspected"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtHistorySparePart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Spare Part: Display connector"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtHistoryQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Quantity: 1"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtHistoryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Updated: 2026-09-05 10:30:00"
            android:textColor="#888888"
            android:textSize="13sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>